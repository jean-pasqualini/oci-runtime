{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(go *)"
    ],
    "deny": [
      "Bash(* ls *)",
      "Bash(* find *)",
      "Bash(* grep *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/tools/wrapper_cli.sh"
          }
        ]
      }
    ]
  }
}
